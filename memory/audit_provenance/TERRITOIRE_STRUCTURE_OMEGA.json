  "transformations_data_flow": {
    "1_user_request": {
      "step": "Frontend fetch via useMapBundleV8",
      "cache_check": "bundleCacheGet(key) — window LRU 90s"
    },
    "2_backend_cache_check": {
      "step": "v20_performance_bundle._cache_get(key)",
      "layers": ["LRU in-memory (10000 entries · 24h TTL)", "Redis L1 (si dispo)", "Disque pickle"]
    },
    "3_compute_v10": {
      "step": "compute_territoire_v10",
      "hardcap": "6s user / 12s warmup",
      "sub_components": ["terrain_v10 (await)", "open_meteo + LIDAR_IRDA fallback", "zones + hotspots + salines + affuts SYNC"]
    },
    "4_compute_v5_corridors": {
      "step": "generate_organic_corridors",
      "budget": "max(2s, hardcap - V10_elapsed)",
      "early_return_si_v10_degraded": true
    },
    "5_pipeline_post_v5": {
      "step": "RenduΩ + veineux + interzone + predictive",
      "global_deadline": "10s",
      "skip_si_dépassé": true
    },
    "6_cache_set_response": {
      "step": "_cache_set(key, result)",
      "ttl_choisi": "90s si degraded, 86400s sinon",
      "bg_callback_si_timeout": "task continue + cache à la fin"
    }
  },

