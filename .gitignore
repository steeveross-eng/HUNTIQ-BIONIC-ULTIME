# ============================
# BIONIC ULTIME – .gitignore
# Version : V10.0.0
# ============================

########################################
# PYTHON / FASTAPI
########################################
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.pkl
*.egg-info/
*.egg
*.log
*.sqlite3
*.db
*.db-journal

# Virtualenv
venv/
env/
ENV/
.venv/

# Pipenv
Pipfile.lock

# Poetry
poetry.lock

########################################
# NODE / REACT / FRONTEND
########################################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.pnp/
.pnp.js

# Build output
dist/
build/
.next/
out/

# Tailwind
*.css.map

########################################
# EDITORS / IDE
########################################
.vscode/
.idea/
*.swp
*.swo

########################################
# ENVIRONMENT / SECRETS
########################################
.env
.env.*
*.secret
*.key
*.pem
*.crt
*.cert
*.token

########################################
# MONGODB / DATA / DUMPS
########################################
*.bson
*.json.dump
dump/
mongo_dump/
mongodb_backup/
*.archive

########################################
# BIONIC ENGINES / TEMP FILES
########################################
cache/
tmp/
temp/
__cache__/
*.cache
*.tmp

########################################
# LOGS
########################################
logs/
*.log
*.out
*.err

########################################
# FRONTEND ASSETS
########################################
public/static/
public/assets/
*.png
*.jpg
*.jpeg
*.svg
*.webp
*.ico

########################################
# OS FILES
########################################
.DS_Store
Thumbs.db

########################################
# EMERGENT / BUILDER
########################################
.emergent/
.emergent-cache/
